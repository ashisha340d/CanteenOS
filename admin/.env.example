# Base URL of the backend API, including the /api/v1 prefix. Leave unset to derive it from
# whatever host the admin UI itself was opened from (localhost, LAN IP, or Tailscale address) —
# only set this explicitly when the API genuinely lives on a different host than the admin UI.
#VITE_API_BASE_URL=http://localhost:4000/api/v1

# URL of the CustomerKiosk web app, shown on the Kiosks page to open and check. Leave unset to
# derive it from the admin UI's own hostname on port 5180 (the kiosk app's documented dev
# port) — only set this when the kiosk app is genuinely hosted elsewhere.
#VITE_KIOSK_APP_URL=http://localhost:5180
