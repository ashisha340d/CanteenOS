{
  "name": "@menuboard/backend",
  "version": "1.0.0",
  "private": true,
  "description": "MenuBoard backend \u2014 Express, MariaDB, Socket.IO",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -b && node scripts/copy-assets.mjs",
    "clean": "tsc -b --clean",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -b",
    "migrate": "tsx src/db/cli/migrate.ts",
    "migrate:status": "tsx src/db/cli/migrate.ts --status",
    "seed": "tsx src/db/cli/seed.ts",
    "seed:cleaning": "tsx src/db/cli/seedCleaning.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:socket": "node scripts/smoke-socket.mjs",
    "smoke:pos": "node scripts/smoke-pos.mjs",
    "smoke:chat": "node scripts/smoke-chat.mjs",
    "smoke:chat-socket": "node scripts/smoke-chat-socket.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@menuboard/shared": "1.0.0",
    "@simplewebauthn/server": "^13.3.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^3.10.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "mysql2": "^3.11.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
