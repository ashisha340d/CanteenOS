# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=4000
# Public origin used to build absolute media URLs.
PUBLIC_URL=http://localhost:4000
# Comma-separated list. The Admin Portal origin must appear here.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Never commit a real database password. This is a placeholder — every deployment must supply
# its own, out of band (a secrets manager, CI secret store, or an untracked local .env).
DB_PASSWORD=radhe
DB_NAME=menuboard
DB_CONNECTION_LIMIT=15

# ------------------------------------------------------------------- auth
# REQUIRED in every environment, including local dev: at least 32 random characters, and must
# not be the literal placeholder below in production (config/index.ts refuses to boot in
# production if JWT_SECRET still contains "change-me"). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never reuse the same secret across environments, and never commit a real value to source
# control — this file is the template, not the deployed configuration.
JWT_SECRET=change-me-in-production-minimum-32-characters-long
JWT_ISSUER=menuboard
JWT_AUDIENCE=menuboard-clients
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------ media
# Relative to the backend package root.
MEDIA_ROOT=storage/media
MEDIA_TMP=storage/tmp
# Time-limited media URL validity.
MEDIA_URL_TTL_MINUTES=120

# -------------------------------------------------------------- security
# TRUST_PROXY and FORCE_HTTPS must both be true in every production deployment that sits
# behind a real TLS-terminating reverse proxy / load balancer (nginx, an ALB, Cloudflare,
# etc.) — this is not optional hardening, it is the expected production posture:
#   - TRUST_PROXY=true makes Express honour X-Forwarded-* from the proxy (correct client IP
#     for rate limiting and audit logs, correct req.secure for cookie/HSTS decisions).
#   - FORCE_HTTPS=true enables HSTS and redirects/refuses plain HTTP.
# Leave both false only for local development or a sandbox with no public network exposure.
TRUST_PROXY=false
FORCE_HTTPS=false
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# NOTE: the rate limiter (express-rate-limit, middleware/rateLimit.ts) keeps its counters in
# this process's memory. That is correct and sufficient for a single backend instance, but a
# horizontally-scaled deployment (multiple backend processes/containers behind a load
# balancer) needs a shared store (e.g. a Redis-backed express-rate-limit store) or each
# instance enforces its own independent limit, effectively multiplying the real ceiling by
# the instance count. See docs/ARCHITECTURE.md §Production notes.

# ------------------------------------------------------------------- logs
# error | warn | info | debug — production should run at "info": "debug" is too noisy and
# "error"/"warn" would hide the audit-adjacent request logging useful for incident review.
LOG_LEVEL=info
