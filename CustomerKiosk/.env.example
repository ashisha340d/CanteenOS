# Base URL of the backend API, including the /api/v1 prefix. Leave unset to derive it from
# whatever host the kiosk itself was opened from, so one build works on any tablet.
#VITE_API_BASE_URL=http://localhost:4000/api/v1

# No payment gateway is integrated yet (MENUBOARD_SPEC.md §3d). With this set to true the
# payment screen shows a demonstration UPI QR and an explicit "mark as received" control for
# staff, and labels itself as a demonstration on screen. Set it to false in production the
# moment a gateway exists — the kiosk then waits for a real confirmation instead.
VITE_KIOSK_DEMO_PAYMENT=true
