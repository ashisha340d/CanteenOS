{
  "expo": {
    "name": "MenuBoard",
    "slug": "menuboard-app",
    "scheme": "menuboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "web",
      "android"
    ],
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "android": {
      "package": "com.menuboard.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MenuBoard needs access to your photos to attach images to orders."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MenuBoard uses the camera to scan the QR label on a machine and to photograph or film a fault.",
          "microphonePermission": "MenuBoard records audio with a fault video so you can say what is wrong while filming it.",
          "recordAudioAndroid": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "http://100.77.100.67:4000/api/v1",
      "apiBaseUrlWeb": "http://localhost:4000/api/v1"
    }
  }
}