# ---------------------------------------------------------------- API endpoints
# Set the active endpoint by uncommenting one of the API_BASE_URL lines below.
# The app logs every option on startup so you can see which one is selected.
#
# HOST      = Android emulator alias for the dev machine (10.0.2.2)
# LOCALHOST = Web dev build running in the same browser/machine
# NETWORK   = Your machine's LAN IP (change this when your DHCP address changes)
# TAILSCALE = Your Tailscale IP (stable across networks)

API_BASE_URL_HOST=http://10.0.2.2:4000/api/v1
API_BASE_URL_LOCALHOST=http://localhost:4000/api/v1
API_BASE_URL_NETWORK=http://192.168.1.37:4000/api/v1
API_BASE_URL_TAILSCALE=http://100.77.100.67:4000/api/v1

# Active endpoint used by the app. Comment/uncomment to switch.
API_BASE_URL=http://100.77.100.67:4000/api/v1
